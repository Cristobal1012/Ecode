# Copia este archivo como .env y completa los valores. El .env nunca se sube a git.
# toda variable nueva se documenta aquí con un valor de ejemplo seguro.

# ===== Django =====
# Desarrollo: DEBUG=True. Producción: omitirla o False (los ajustes de seguridad quedan activos por defecto).
DEBUG=True
# Obligatoria con DEBUG=False (no puede empezar con "django-insecure"). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Cambiarla cierra todas las sesiones y JWT vigentes.
SECRET_KEY=
# Dominios que atiende el backend, separados por coma. Con DEBUG=True, por defecto: localhost,127.0.0.1
ALLOWED_HOSTS=
# Orígenes del frontend que pueden llamar a la API. Con DEBUG=True, por defecto: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
# Orígenes HTTPS de confianza para formularios con CSRF (ej. https://api.mitienda.cl), separados por coma
CSRF_TRUSTED_ORIGINS=
# URL pública del frontend: Webpay vuelve al backend y este redirige aquí (pago exitoso, cancelado, rechazado)
FRONTEND_URL=http://localhost:5173
# Exige que Términos y Condiciones y Política de Privacidad estén publicadas para poder comprar.
# Por defecto: activo con DEBUG=False (producción) y apagado con DEBUG=True (desarrollo).
# EXIGIR_PAGINAS_LEGALES=True

# ===== Inicio de sesión con Google (RN-04) =====
# ID de cliente OAuth de tipo "Aplicación web" (Google Cloud Console > Google Auth Platform > Clientes).
# Es público: termina en .apps.googleusercontent.com. El secreto del cliente NO se usa: no lo pongas aquí.
# En "Orígenes de JavaScript autorizados" va la URL del frontend (en desarrollo: http://localhost:5173).
# Vacío = la tienda no ofrece iniciar sesión con Google (el botón no aparece).
GOOGLE_CLIENT_ID=

# ===== Correos al comprador (RF-04.2) =====
# Servidor SMTP. Vacío = los correos se imprimen en la consola del runserver (no se envían).
# Ejemplo de desarrollo con Gmail: activa la verificación en 2 pasos de tu cuenta y crea una "contraseña de
# aplicación" (myaccount.google.com/apppasswords); va en EMAIL_HOST_PASSWORD, nunca tu contraseña normal.
# Gmail permite ~500 correos al día: sirve para probar, no para una tienda en producción.
EMAIL_HOST=
# EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente que ve el comprador. Con Gmail debe ser la misma cuenta, ej.: Mi Tienda <tu-cuenta@gmail.com>
DEFAULT_FROM_EMAIL=
# Segundos máximos de espera al servidor de correo (por defecto 10)
# EMAIL_TIMEOUT=10

# ===== HTTPS =====
# Con DEBUG=False están activos por defecto; con DEBUG=True, apagados. Descomenta solo para cambiarlos.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Segundos que el navegador recuerda "solo HTTPS" (HSTS). Por defecto 3600; subir a 31536000 solo después de
# verificar que el HTTPS funciona, porque el navegador lo recuerda aunque luego se desactive.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Confía en el encabezado X-Forwarded-Proto del proxy del hosting, que es quien termina el HTTPS.
# Sin esto, SECURE_SSL_REDIRECT redirige en bucle. Desactivar solo si Django recibe HTTPS directamente.
# CONFIAR_PROXY_HTTPS=True

# ===== PostgreSQL (valores de docker-compose.yml, solo desarrollo) =====
POSTGRES_DB=ecommercedb
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== MongoDB (valores de docker-compose.yml, solo desarrollo) =====
MONGO_URI=mongodb://root:rootpassword@localhost:27017/ecommerce_mongo_db?authSource=admin
# Opcional: servidor donde los tests del catálogo crean bases temporales (por defecto, MONGO_URI)
# MONGO_TEST_URI=mongodb://root:rootpassword@localhost:27017/?authSource=admin

# ===== Imágenes del catálogo (ver docs/IMAGENES_CATALOGO.md) =====
# Por defecto: <carpeta del proyecto>/media y /media/
# MEDIA_ROOT=
# MEDIA_URL=/media/
# CATALOGO_IMAGEN_MAX_BYTES=5242880
# CATALOGO_IMAGEN_MAX_ARCHIVOS=10
# CATALOGO_IMAGEN_MAX_GALERIA=20
# CATALOGO_IMAGEN_MAX_PIXELES=20000000

# ===== Proveedores de logística y pago =====
# TODO(PENDIENTE): pide que estas credenciales las cargue el admin desde el panel (cifradas en
# PostgreSQL), no en el .env. Mientras tanto, usa solo credenciales de sandbox.

# Chilexpress (portal de desarrolladores, ambiente de pruebas)
CHILEXPRESS_API_KEY_COTIZADOR=
CHILEXPRESS_API_KEY_COBERTURAS=
CHILEXPRESS_API_KEY_ENVIOS=
# Opcional: oficinas/sucursales. Si está vacía se usa la del cotizador.
CHILEXPRESS_API_KEY_GEO=

# Transbank Webpay Plus: INTEGRACION (sandbox, usa las llaves públicas de prueba de Transbank) o PRODUCCION
TRANSBANK_ENVIRONMENT=INTEGRACION
# Solo se usan con TRANSBANK_ENVIRONMENT=PRODUCCION
TRANSBANK_WEBPAY_COMMERCE_CODE=
TRANSBANK_WEBPAY_API_KEY=
